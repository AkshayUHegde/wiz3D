// The Vulkan stereo layer's version resource: the version every wrapper carries (Shared\version.h).
#include <winver.h>
#include "..\Shared\version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VERSION_NUMBER
 PRODUCTVERSION PRODUCT_VERSION_NUMBER
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000904b0"
        BEGIN
            VALUE "CompanyName", VERSION_COMPANY
            VALUE "FileVersion", VERSION_STRING
            VALUE "LegalCopyright", VERSION_COPYRIGHT
            VALUE "ProductName", FULL_PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
            VALUE "Build Date", VERSION_BUILD_DATE_TIME "\0"
            VALUE "FileDescription", "S3DWrapperVK"
            VALUE "InternalName", "S3DWrapperVK"
            VALUE "OriginalFilename", "S3DWrapperVK.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x9, 1200
    END
END
